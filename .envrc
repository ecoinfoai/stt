use flake

# GPU runs need cuBLAS/cuDNN, which `uv sync --extra cuda` installs as
# wheels inside .venv; CTranslate2 dlopens them by soname only, so their
# directories have to be on LD_LIBRARY_PATH (INSTALL.md §2). direnv caches
# this environment, so run `direnv reload` after the first `uv sync`.
for _cuda_lib in "$PWD"/.venv/lib/python*/site-packages/nvidia/*/lib; do
    if [ -d "$_cuda_lib" ]; then
        export LD_LIBRARY_PATH="$_cuda_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
done
unset _cuda_lib
